# Microsoft Bot Framework Configuration
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__GRAPH__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=graph
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__GITHUB__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=github

CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=your-bot-client-id-here
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=your-bot-client-secret-here

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI Settings (Optional - defaults are shown)
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3
OPENAI_MAX_HISTORY_MESSAGES=10

# Streaming Settings (Optional)
# Enable/disable visible streaming (true/false)
OPENAI_ENABLE_STREAMING=true

# Mode: "chunked" (send every N chars) or "sentence" (complete sentences only)
OPENAI_STREAMING_MODE=chunked
OPENAI_STREAMING_CHUNK_SIZE=150
OPENAI_STREAMING_DELAY=0.3

# Non-streaming mode settings (when OPENAI_ENABLE_STREAMING=false)
OPENAI_SHOW_PROGRESS_MESSAGES=true
OPENAI_PROGRESS_UPDATE_INTERVAL=3
OPENAI_USE_MESSAGE_UPDATES=true

# Server Configuration
HOST=0.0.0.0
PORT=3978
